# ETE_v2 Environment Variables
FLASK_ENV=development
HOST=0.0.0.0
PORT=5050
BACKEND_URL=http://localhost:5050
PHOROPTER_BASE_URL=https://rajasthan-royals.preprod.lenskart.com
CALIBRATION_PATH=config/calibration.csv
LOG_DIR=logs

# Supabase Storage: uploads run only when REMOTE_STORAGE=supabase (opt-in).
# SUPABASE_URL, SUPABASE_SERVICE_KEY, SUPABASE_BUCKET are required for uploads.
# With REMOTE_STORAGE=supabase, session logs are not written under LOG_DIR (Supabase only).
# Leave REMOTE_STORAGE empty or set to none|local|off to keep logs on disk only.
REMOTE_STORAGE=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=Eye_Test_logs
